# direnv override: use the personal-org-scoped PAT for this repo
# (Keychain entry created via:
#   security add-generic-password -s 'gh_personal_pat' -a "$USER" -W
# `-W` reads the PAT from a TTY prompt so it never enters shell history.)
#
# Empty-token guard: a missing or wrong keychain entry would otherwise
# export GH_TOKEN="" silently. `gh` treats empty-string and unset the
# same way, but other tools that distinguish [ -z "$x" ] from "unset"
# can behave inconsistently. We only export when the read returned a
# non-empty value, so a failed read leaves GH_TOKEN untouched.
_gh_tok="$(security find-generic-password -s 'gh_personal_pat' -a "$USER" -w 2>/dev/null)"
if [ -n "$_gh_tok" ]; then
  export GH_TOKEN="$_gh_tok"
  export GITHUB_TOKEN="$_gh_tok"
fi
unset _gh_tok
